# Mite 配置示例
# 复制到 ~/.config/mite/config 后生效：
#   mkdir -p ~/.config/mite
#   cp config.example ~/.config/mite/config
# 环境变量 MITE_FORMAT / MITE_TARGET / MITE_NOTIFY /
# MITE_OUTPUT_DIR / MITE_OPEN_OUTPUT 优先于本文件。

# 输出格式：png 或 webp
FORMAT=png

# 压缩质量：auto 自动选择，或 0-100 的 SSIMULACRA2 目标
TARGET=auto

# 提示方式：dialog 弹窗 / notification 系统通知 / none 静默
NOTIFY=none

# 输出目录名，位于每个源文件所在目录下
OUTPUT_NAME=tinified

# 完成后是否打开输出目录：1 是 / 0 否
OPEN_OUTPUT=1
